                          "value": "application/json"
                        }
                      ],
                      "cookie": [],
                      "responseTime": null,
                      "body": "{\n  \"transactions\": [\n    {\n      \"accountCategory\": \"COMMERCIAL_ACCOUNT\",\n      \"amount\": \"<number>\",\n      \"debitCreditMemo\": \"DEBIT\",\n      \"description\": \"<string>\",\n      \"status\": \"PENDING\",\n      \"transactionId\": \"<string>\",\n      \"transactionTimestamp\": \"<dateTime>\",\n      \"referenceTransactionId\": \"<string>\",\n      \"postedTimestamp\": \"<dateTime>\",\n      \"category\": \"<string>\",\n      \"subCategory\": \"<string>\",\n      \"foreignAmount\": \"<number>\",\n      \"foreignCurrency\": \"LBP\",\n      \"payee\": \"<string>\",\n      \"checkNumber\": \"<integer>\"\n    },\n    {\n      \"accountCategory\": \"INSURANCE_ACCOUNT\",\n      \"amount\": \"<number>\",\n      \"debitCreditMemo\": \"MEMO\",\n      \"description\": \"<string>\",\n      \"status\": \"MEMO\",\n      \"transactionId\": \"<string>\",\n      \"transactionTimestamp\": \"<dateTime>\",\n      \"referenceTransactionId\": \"<string>\",\n      \"postedTimestamp\": \"<dateTime>\",\n      \"category\": \"<string>\",\n      \"subCategory\": \"<string>\",\n      \"foreignAmount\": \"<number>\",\n      \"foreignCurrency\": \"LBP\",\n      \"payee\": \"<string>\",\n      \"checkNumber\": \"<integer>\"\n    }\n  ],\n  \"page\": {\n    \"nextOffset\": \"<string>\",\n    \"totalElements\": \"<integer>\"\n  }\n}",
