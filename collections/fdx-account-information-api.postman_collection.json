        {
          "name": "List all accounts",
          "id": "6f126bcf-6099-40eb-b952-f9273516afd1",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "Account Customer Transactions",
                  "type": "string"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://www.your-organization.com/token",
                  "type": "string"
                },
                {
                  "key": "authUrl",
                  "value": "https://www.your-organization.com/authorize",
                  "type": "string"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts?offset=<string>&limit=<integer>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts"
              ],
              "query": [
                {
                  "description": "An opaque ID that indicates there is at least one more page of data available. This value does not need to be numeric or have any specific pattern. If provided, Plaid will use this value to send a new request and retrieve the next page. Omitting this value indicates that there is no more data to retrieve.\n",
                  "key": "offset",
                  "value": "<string>"
                },
                {
                  "description": "The number of elements that the API consumer wishes to receive. Plaid has a default limit of 100 elements. If your organization has a different limit, use the lower limit to determine how many items to send per page. To retrieve multiple pages, Plaid will use the opaque `nextOffset` field to send a subsequent request until the `nextOffset` is no longer included.\n",
                  "key": "limit",
                  "value": "<integer>"
                }
              ]
            },
            "description": "Search and view customer accounts."
          },
          "response": [
            {
              "id": "51d7ad8d-95ff-4483-8ea4-f7e22ccde31f",
              "name": "An array of accounts. May include accounts of any of the following types: [deposit](#deposit-account), [investment](#investment-account), [line of credit](#line-of-credit-account), [loan](#loan-account)\n\n**Note:** Each object in the accounts array is expe",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "description": "Added as a part of security scheme: oauth2",
                    "key": "Authorization",
                    "value": "<token>"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/accounts?offset=<string>&limit=<integer>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "accounts"
                  ],
                  "query": [
                    {
                      "description": "An opaque ID that indicates there is at least one more page of data available. This value does not need to be numeric or have any specific pattern. If provided, Plaid will use this value to send a new request and retrieve the next page. Omitting this value indicates that there is no more data to retrieve.\n",
                      "key": "offset",
                      "value": "<string>"
                    },
                    {
                      "description": "The number of elements that the API consumer wishes to receive. Plaid has a default limit of 100 elements. If your organization has a different limit, use the lower limit to determine how many items to send per page. To retrieve multiple pages, Plaid will use the opaque `nextOffset` field to send a subsequent request until the `nextOffset` is no longer included.\n",
                      "key": "limit",
                      "value": "<integer>"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "responseTime": null,
              "body": "{\n  \"accounts\": [\n    {\n      \"accountCategory\": \"LOC_ACCOUNT\",\n      \"accountId\": \"<string>\",\n      \"accountType\": \"FIXEDANNUITY\",\n      \"currency\": {\n        \"currencyCode\": \"GYD\"\n      },\n      \"productName\": \"<string>\",\n      \"status\": \"PENDINGCLOSE\",\n      \"accountNumberDisplay\": \"<string>\",\n      \"nickname\": \"<string>\"\n    }\n  ],\n  \"page\": {\n    \"nextOffset\": \"<string>\",\n    \"totalElements\": \"<integer>\"\n  }\n}",
              "createdAt": "2026-10-22T02:54:43.000Z",
