    {
      "name": "accounts",
      "item": [
        {
          "name": "{accountId}",
          "item": [
            {
              "name": "Get detailed information for a specific account",
              "id": "0941eaea-f2a5-4775-a0cf-010b46b1047b",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "auth": {
                  "type": "oauth2",
                  "oauth2": [
                    {
                      "key": "scope",
                      "value": "Account Customer Transactions",
                      "type": "string"
                    },
                    {
                      "key": "accessTokenUrl",
                      "value": "https://www.your-organization.com/token",
                      "type": "string"
                    },
                    {
                      "key": "authUrl",
                      "value": "https://www.your-organization.com/authorize",
                      "type": "string"
                    },
                    {
                      "key": "grant_type",
                      "value": "authorization_code",
                      "type": "string"
                    }
                  ]
                },
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/accounts/:accountId",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "accounts",
                    ":accountId"
                  ],
                  "variable": [
                    {
                      "id": "a46bf07d-e71c-48d6-9681-a62674531827",
                      "key": "accountId",
                      "value": "<string>",
                      "description": "(Required) Account identifier, found in the `GET /accounts` endpoint response.\nPlaid expects the ID to be a different value from the account number\n\n**Note:** If the status of the `accountId` provided is `RESTRICTED`, you can send a 200 response with an empty body to indicate that no payment networks are available at this time.\n"
                    }
                  ]
                },
                "description": "Get account balances, liabilities, and other information. Plaid calls this endpoint for deposit, investment, loan, and line of credit accounts. Plaid uses this endpoint to get balances for deposit accounts, get liabilities for `STUDENTLOAN`, `MORTGAGE`, and `CREDITCARD` loan accounts, and get balances and holdings for investment accounts.\n\nSee Plaid Balance API, Plaid Liabilities API, and Plaid Investments API for more information on how Plaid uses this information.\n\n**Info**: Plaid does not call `/accounts/{accountId}` for annuity accounts, commercial accounts, or insurance accounts. These account categories are discoverable-only. The accounts appear in `GET /accounts`, but Plaid does not consume downstream data (balances, transactions, Auth) for these categories."
              },
              "response": [
                {
                  "id": "d0357639-bde2-467c-b08c-d87475bc893e",
                  "name": "The full details of an investment, loan, deposit, or line of credit account\n",
                  "originalRequest": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      },
                      {
                        "description": "Added as a part of security scheme: oauth2",
                        "key": "Authorization",
                        "value": "<token>"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/accounts/:accountId",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "accounts",
                        ":accountId"
                      ],
                      "variable": [
                        {
                          "key": "accountId"
                        }
                      ]
                    }
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/json"
                    }
                  ],
                  "cookie": [],
                  "responseTime": null,
                  "body": "{\n  \"accountCategory\": \"LOC_ACCOUNT\",\n  \"accountId\": \"<string>\",\n  \"accountType\": \"SAVINGS\",\n  \"availableBalance\": \"<number>\",\n  \"currency\": {\n    \"currencyCode\": \"XDR\"\n  },\n  \"currentBalance\": \"<number>\",\n  \"productName\": \"<string>\",\n  \"status\": \"RESTRICTED\",\n  \"accountNumberDisplay\": \"<string>\",\n  \"nickname\": \"<string>\"\n}",
                  "createdAt": "2026-10-22T02:54:43.000Z",
                  "updatedAt": "2026-10-22T02:54:43.000Z",
                  "uid": "35240-d0357639-bde2-467c-b08c-d87475bc893e"
                }
              ],
              "createdAt": "2026-10-22T02:54:43.000Z",
              "updatedAt": "2026-10-22T02:54:43.000Z",
              "uid": "35240-0941eaea-f2a5-4775-a0cf-010b46b1047b"
            }
          ],
