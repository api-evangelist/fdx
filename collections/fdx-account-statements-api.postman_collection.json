                  },
                  "request": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/accounts/:accountId/statements?offset=<string>&limit=<integer>&startTime=<date>&endTime=<date>",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "accounts",
                        ":accountId",
                        "statements"
                      ],
                      "query": [
                        {
                          "description": "An opaque ID that indicates there is at least one more page of data available. This value does not need to be numeric or have any specific pattern. If provided, Plaid will use this value to send a new request and retrieve the next page. Omitting this value indicates that there is no more data to retrieve.\n",
                          "key": "offset",
                          "value": "<string>"
                        },
                        {
                          "description": "The number of elements that the API consumer wishes to receive. Plaid has a default limit of 100 elements. If your organization has a different limit, use the lower limit to determine how many items to send per page. To retrieve multiple pages, Plaid will use the opaque `nextOffset` field to send a subsequent request until the `nextOffset` is no longer included.\n",
                          "key": "limit",
                          "value": "<integer>"
                        },
                        {
                          "description": "Start time for use in retrieval of elements (ISO 8601). When used with the `/transactions` endpoint, Plaid filters by the `postedTimestamp`.\n",
                          "key": "startTime",
                          "value": "<date>"
                        },
                        {
                          "description": "End time for use in retrieval of elements (ISO 8601). When used with the `/transactions` endpoint, Plaid filters by the `postedTimestamp`.\n",
                          "key": "endTime",
                          "value": "<date>"
                        }
                      ],
